# Copy this file to .env for local development.
# Do not commit real credentials.

UPV_DNI=12345678A
UPV_PASSWORD=change-me

# Session codes are the suffixes used by the UPV activity labels, for example MUS045.
UPV_SESSION_CODES=045,060,075

# Safe default. Set false only when you want to attempt real bookings.
UPV_DRY_RUN=true
UPV_MAX_ATTEMPTS=3
UPV_RETRY_SECONDS=5
UPV_TIMEOUT_SECONDS=15

# Current UPV gym activity page. Override if the endpoint changes.
UPV_ACTIVITY_URL=https://intranet.upv.es/pls/soalu/sic_depact.HSemActividades?p_campus=V&p_codacti=21809&p_vista=intranet&p_idioma=i&p_tipoact=6846&p_solo_matricula_sn=&p_anc=bloque_inscritas

# Required only for the optional web app /reserve endpoint.
UPV_ADMIN_TOKEN=replace-with-a-random-token
